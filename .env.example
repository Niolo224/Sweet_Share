# ─────────────────────────────────────────────────────────────
#  Sweet Share — environment variables
#  Copy this file to `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────

# Database. SQLite works out of the box for local development.
# For production, see INTEGRATIONS.md (Turso, Neon or Supabase).
DATABASE_URL="file:./dev.db"

# The kitchen door. Change this before you go live — it is the ONLY
# thing standing between the public and your admin dashboard.
ADMIN_PASSWORD="change-me-before-you-launch"

# A long random string used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Public site URL, used for canonical links, emails and social cards.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Optional integrations ────────────────────────────────────
# Everything below is optional. The site runs perfectly without
# them; each one simply switches on an extra capability.

# Stripe — turns on the "Send payment link" button in the orders dashboard.
# Without these the shop still works; you just arrange payment yourself.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
#
# Required for orders to mark themselves paid. Get it from either:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
#   or the Stripe dashboard, once you add the endpoint
#   https://your-domain/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Protects the daily job that raises club boxes. Generate any long random
# string; Vercel Cron sends it automatically once it is set here.
# Without it the job refuses to run in production.
# CRON_SECRET="a-long-random-string"

# Resend — send order confirmations and newsletters.
# RESEND_API_KEY="re_..."
# ORDER_NOTIFICATION_EMAIL="orders@sweetshare.com"
# FROM_EMAIL="Sweet Share <hello@sweetshare.com>"

# Vercel Blob — durable image uploads in production.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
