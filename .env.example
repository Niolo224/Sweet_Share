# ─────────────────────────────────────────────────────────────
#  Sweet Share — environment variables
#  Copy this file to `.env` and fill in your own values.
#  See DEPLOY.md for where each of these comes from.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
# Postgres. Supabase, Neon, Railway, or your own server.
#
# Supabase gives you two connection strings and Prisma needs both:
#   DATABASE_URL — the POOLED one, port 6543, ends with ?pgbouncer=true
#   DIRECT_URL   — the DIRECT one, port 5432
# A pooler cannot carry a migration, which is what DIRECT_URL is for.
# If your provider has no pooler, set both to the same string.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# ── The kitchen door (required) ──────────────────────────────
# The only thing between the public and your admin dashboard.
ADMIN_PASSWORD="change-me-before-you-launch"

# Signs the admin session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Your address (required) ──────────────────────────────────
# Used for canonical links, social cards, and Stripe return URLs.
NEXT_PUBLIC_SITE_URL="https://sweetshare.shop"

# ─────────────────────────────────────────────────────────────
#  Everything below is optional — the shop runs without it.
# ─────────────────────────────────────────────────────────────

# ── Stripe ───────────────────────────────────────────────────
# Switches on payment links, gift cards and the club.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Without this, payments work but nothing marks itself paid.
# Locally:  stripe listen --forward-to localhost:3000/api/stripe/webhook
# Live:     the signing secret of your dashboard webhook endpoint.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── The daily club job ───────────────────────────────────────
# Protects /api/cron/club-boxes. Any long random string.
# Vercel Cron sends it automatically once set. WITHOUT THIS, IN
# PRODUCTION, NO CLUB BOXES ARE EVER RAISED.
# CRON_SECRET="a-long-random-string"

# ── Email ────────────────────────────────────────────────────
# Without a key, emails print to the server log instead of sending.
# RESEND_API_KEY="re_..."
# FROM_EMAIL="Sweet Share <hello@sweetshare.shop>"
# ORDER_NOTIFICATION_EMAIL="orders@sweetshare.shop"

# ── Image uploads ────────────────────────────────────────────
# Needed in production: serverless filesystems are read-only, so
# admin uploads have nowhere to go without this.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Brand imagery ────────────────────────────────────────────
# After `npm run media:download`, set this to serve images from
# your own domain rather than the Higgsfield CDN.
# NEXT_PUBLIC_LOCAL_MEDIA="1"
